# progress-service (BC#4) вЂ” local/test configuration.
# Copy to .env.local and export into the process environment (cmd/server does not read dotenv).

# Server
ENV=local
HTTP_ADDR=:8082

# PostgreSQL (own BC#4 database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=saymo_progress
POSTGRES_USER=saymo
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgres://saymo:changeme@localhost:5434/saymo_progress?sslmode=disable
MIGRATIONS_PATH=./migrations

# Own Redis (L2 cache, idempotency)
REDIS_ADDR=localhost:6381
REDIS_PASSWORD=changeme
REDIS_PORT=6381
CACHE_TTL=5m
LOCAL_CACHE_TTL=60s
IDEMPOTENCY_TTL=24h

# Shared redis-blacklist (jti blacklist + account rev), owner: identy-service
REDIS_BLACKLIST_ADDR=localhost:6380
REDIS_BLACKLIST_PASSWORD=changeme
REDIS_BLACKLIST_PORT=6380

# JWT (BC#1 JWKS)
JWKS_URL=http://localhost:8099/jwks.json
JWKS_REFRESH_TTL=1h
JWT_ISSUER=saymo-iam
JWT_AUDIENCE=saymo
JWT_KID=key-v1
JWT_PRIVATE_KEY_PATH=./testdata/keys/private.pem
MOCK_JWKS_ADDR=:8099
MOCK_JWKS_PUBLIC_KEY=./testdata/keys/public.pem

# BC#3 catalog (sync HTTP)
BC3_BASE_URL=http://localhost:8081
BC3_TIMEOUT=2s
BC3_RETRY_DELAY=500ms
BC3_CIRCUIT_FAILURES=5
BC3_CIRCUIT_OPEN=30s

# Kafka (empty = disabled: no consumers, no outbox publishing)
KAFKA_BROKERS=
KAFKA_GROUP_ID=progress-service
KAFKA_IDENTITY_TOPIC=saymo.identity.events
KAFKA_BILLING_TOPIC=saymo.billing.events
KAFKA_CONTENT_TOPIC=saymo.content.events
KAFKA_PORT=9094
KAFKA_PROGRESS_TOPIC=saymo.progress.events
KAFKA_DLQ_TOPIC=saymo.deadletter

# Yandex Object Storage (S3-compatible). Unsigned presign is disabled without keys.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=saymo-answers
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_PUT_TTL=15m
S3_PRESIGN_GET_TTL=1h
S3_FORCE_PATH_STYLE=false

# Service-to-service credential for BC#3 deletion guard (required; no empty default)
INTERNAL_SERVICE_TOKEN=changeme-service-token

# Catalogue default tariff for local/test only (127 = every day). Set 0 in prod
# so no lessons unlock until a real BC#2 tariff event arrives (invariant Rule 3).
TARIFF_DEFAULT_WEEK_BITMAP=127

# CORS (fail-closed: unknown origins get no CORS headers)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=progress-service
LOG_LEVEL=info
LOG_FORMAT=json


