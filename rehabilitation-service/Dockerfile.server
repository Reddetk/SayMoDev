# Multi-stage: сборка -> distroless (docs/deployment/docker.md).
FROM golang:1.26-alpine AS builder

WORKDIR /src

ARG VERSION=dev
ARG COMMIT=none

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT} -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    -o /out/rehabilitation-service ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /
COPY --from=builder /out/rehabilitation-service /rehabilitation-service

EXPOSE 8003 9003

ENTRYPOINT ["/rehabilitation-service"]
