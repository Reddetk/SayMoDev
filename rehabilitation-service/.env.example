# Placeholder-значения. Реальные секреты — только через env/secret manager.
# ENV=local|test|prod
ENV=local
LOG_LEVEL=info

# HTTP и metrics (docs: BC#3 — 8003 / 9003)
HTTP_ADDR=:8003
METRICS_ADDR=:9003

# PostgreSQL (content_db, владелец BC#3)
POSTGRES_DSN=postgres://USER:PASSWORD@HOST:PORT/content_db?sslmode=disable

# Redis L2-кэш BC#3
REDIS_ADDR=HOST:PORT
REDIS_PASSWORD=CHANGE_ME

# Shared redis-blacklist (владелец identy-service)
REDIS_BLACKLIST_ADDR=HOST:PORT
REDIS_BLACKLIST_PASSWORD=CHANGE_ME

# Kafka (saymo.content.events / saymo.progress.events)
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092

# S3 / Yandex Object Storage (бакет приватный)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=saymo-programs
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# BC#1 JWKS (публичный ключ RS256)
JWKS_URL=https://identity.saymo.internal/jwks.json

# BC#4 (deletion guard, internal cluster-only)
BC4_URL=http://progress-service:8004
BC4_SERVICE_TOKEN=CHANGE_ME
