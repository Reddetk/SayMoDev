# ---------------------------------------------------------------------------
# identity-service -- local development environment
# ---------------------------------------------------------------------------
# Скопируй этот файл в identy-service/.env и заполни значения.
# .env никогда не коммитится (он в .gitignore).
# В production/staging переменные приходят из Kubernetes Secrets -- этот файл
# там не нужен и не используется.
# ---------------------------------------------------------------------------

# HTTP
HTTP_ADDR=:8080

# PostgreSQL (docker-compose локального стенда)
DATABASE_URL=postgres://saymo:saymo@localhost:5432/saymo_identity?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# RSA ключи -- генерируй локально:
#   openssl genrsa -out local_rsa.pem 2048
#   openssl rsa -in local_rsa.pem -pubout -out local_rsa_pub.pem
# JWKS собирается отдельным скриптом или dev-утилитой.
RSA_KEY_PATH=./local_rsa.pem
JWKS_PATH=./local_jwks.json

# OpenTelemetry (Jaeger локально через docker-compose)
OTEL_ENDPOINT=localhost:4317

# Идентификация сервиса
SERVICE_NAME=identity-service
SERVICE_VERSION=dev
ENVIRONMENT=development

# Логирование
LOG_LEVEL=debug
LOG_DEVELOPMENT=true

# Google OAuth -- создай dev credentials в Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Yandex Postbox IAM token -- для локального теста можно подставить фейковый,
# если не тестируешь реальную отправку писем.
POSTBOX_IAM_TOKEN=fake-iam-token-for-local
POSTBOX_FROM_ADDRESS=noreply@saymo.ru

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600
