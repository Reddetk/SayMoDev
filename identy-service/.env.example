# ---------------------------------------------------------------------------
# identity-service -- шаблон переменных окружения
# ---------------------------------------------------------------------------

# Server
SERVER_PORT=8080
HTTP_ADDR=:8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saymo_identity
POSTGRES_USER=saymo
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgres://saymo:changeme@localhost:5432/saymo_identity?sslmode=disable

# Migrations
MIGRATIONS_PATH=./migrations

# Redis -- собственный L2-кэш (JWKS-кэш, сессии)
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# Redis Blacklist -- shared инстанс (jti blacklist + account rev)
# Пишет только BC#1. Читают BC#1, BC#3, BC#4 через middleware.
REDIS_BLACKLIST_ADDR=localhost:6380
REDIS_BLACKLIST_PASSWORD=changeme
REDIS_BLACKLIST_PORT=6380

# RSA ключи для JWT (RS256)
# Генерация:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out testdata/keys/private.pem
#   openssl rsa -pubout -in testdata/keys/private.pem -out testdata/keys/public.pem
JWT_PRIVATE_KEY_PATH=./testdata/keys/private.pem
JWT_PUBLIC_KEY_PATH=./testdata/keys/public.pem
JWT_KID=key-v1
# Опционально -- предыдущий ключ при ротации (overlap window >= 7 дней)
# JWT_PREV_PUBLIC_KEY_PATH=./testdata/keys/prev_public.pem
# JWT_PREV_KID=key-v0

# Google OAuth2 (PKCE flow)
# Создай credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/iam/auth/oauth/google/callback

# Yandex Cloud Postbox (OTP email delivery)
# Для локального теста используй фейковый токен если не тестируешь реальную отправку
POSTBOX_IAM_TOKEN=fake-iam-token-for-local
POSTBOX_FROM_ADDRESS=noreply@saymo.ru

# CORS (Invariant §8: CORS before JWT)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=identity-service

# Logging
LOG_LEVEL=debug
LOG_FORMAT=console
