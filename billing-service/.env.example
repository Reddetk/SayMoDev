# ---------------------------------------------------------------------------
# billing-service (BC#2) — шаблон окружения. Скопируйте в .env.local
# и подставьте локальные значения. .env.* не коммитятся.
# ---------------------------------------------------------------------------

# Среда: local | test | prod
ENV=local

# HTTP-порты (Observability.md, Service Ports)
SERVER_PORT=8002
METRICS_PORT=9002

# PostgreSQL (billing_db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_DB=billing_db
POSTGRES_USER=saymo
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgres://saymo:changeme@localhost:5442/billing_db?sslmode=disable

# Миграции
MIGRATIONS_PATH=./migrations

# Redis — собственный L2-инстанс BC#2 (idempotency, tariff cache, rate limit)
REDIS_ADDR=localhost:6392
REDIS_PASSWORD=changeme
REDIS_PORT=6392

# Redis Blacklist (shared, владелец BC#1). Нужен с шага 4 (JWT validation).
REDIS_BLACKLIST_ADDR=localhost:6384
REDIS_BLACKLIST_PASSWORD=changeme
REDIS_BLACKLIST_PORT=6384

# Kafka
KAFKA_BROKERS=localhost:29192
KAFKA_PORT=29192
KAFKA_EVENTS_TOPIC=saymo.billing.events
KAFKA_IDENTITY_TOPIC=saymo.identity.events
KAFKA_CONSUMER_GROUP=billing-service

# JWT (BC#1) — используется с шага 4
JWT_ISSUER=urn:saymo:identity-service
JWT_AUDIENCE=api.saymo
JWT_PUBLIC_KEY_PATH=./testdata/keys/public.pem
JWKS_URL=http://localhost:8001/jwks.json

# WebPay ACL (шаг 5). Локально — cmd/acquiringmock; URL обязан быть https в prod.
ACQUIRING_API_URL=http://localhost:9031/pay
ACQUIRING_STORE_ID=test-store
ACQUIRING_SECRET_KEY=local-secret
ACQUIRING_RETURN_URL=http://localhost:3000/billing/return
ACQUIRING_NOTIFY_URL=http://localhost:8002/billing/webhooks/acquiring

# Yandex Cloud Postbox ACL (шаг 10). Локально — cmd/postboxmock.
# Auth: либо POSTBOX_IAM_TOKEN, либо POSTBOX_ACCESS_KEY + POSTBOX_SECRET_KEY (SigV4).
POSTBOX_ENDPOINT=http://localhost:9025/v2/email/outbound-emails
POSTBOX_IAM_TOKEN=fake-iam-token-for-local
POSTBOX_ACCESS_KEY=
POSTBOX_SECRET_KEY=
POSTBOX_REGION=ru-central1
POSTBOX_FROM_ADDRESS=noreply@saymo.ru
POSTBOX_DEFAULT_RECIPIENT=patient@example.com

# Health / shutdown
HEALTH_TIMEOUT=2s
SHUTDOWN_TIMEOUT=15s
LIFECYCLE_INTERVAL=15m

# Логи и телеметрия
LOG_LEVEL=debug
LOG_FORMAT=console
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4322
